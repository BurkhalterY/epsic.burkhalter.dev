<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable directory listing (prevents users from seeing folder contents)
    Options -Indexes

    # If the request is for an existing file, serve it normally
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # If the request is for an existing directory, redirect to index.html
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^.*$ /index.html [L]

    # Redirect all other requests to index.html for Vue Router to handle
    RewriteRule . /index.html [L]
</IfModule>
